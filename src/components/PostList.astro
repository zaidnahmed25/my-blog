---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

// Posts arrive newest first; number them in publishing order so the
// first post ever written stays 01.
const { posts } = Astro.props;
const number = (i: number) => String(posts.length - i).padStart(2, '0');
---

{posts.length === 0 ? (
  <p class="muted">No posts yet.</p>
) : (
  <ol class="index">
    {posts.map((post, i) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <span class="index-title">{post.data.title}</span>
          <span class="index-num">{number(i)}</span>
        </a>
        <p class="index-meta">
          <FormattedDate date={post.data.pubDate} /> — {post.data.description}
        </p>
      </li>
    ))}
  </ol>
)}
